{
  "name": "frame-studio-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter frame-studio run dev",
    "build": "pnpm -r run build",
    "check": "tsc -b --pretty false && node scripts/check-copy.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:smoke": "node bench/run.mjs --smoke",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
