{
  "name": "frame-studio-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter frame-studio run dev",
    "build": "node scripts/build-site.mjs",
    "check": "tsc -b --pretty false && node scripts/check-copy.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:smoke": "node --experimental-strip-types --no-warnings bench/run.ts --smoke",
    "bench": "node --experimental-strip-types --no-warnings bench/run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "frame-studio": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
